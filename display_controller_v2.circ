<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="3.8.0" version="1.0">
  This file is intended to be loaded by Logisim-evolution v3.8.0(https://github.com/logisim-evolution/).
  <lib desc="#Wiring" name="0">
    <tool name="Pin"><a name="appearance" val="classic"/></tool>
  </lib>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#Base" name="8"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <mappings>
    <tool lib="8" map="Button2" name="Poke Tool"/>
    <tool lib="8" map="Button3" name="Menu Tool"/>
    <tool lib="8" map="Ctrl Button1" name="Menu Tool"/>
  </mappings>
  <toolbar>
    <tool lib="8" name="Poke Tool"/>
    <tool lib="8" name="Edit Tool"/>
    <tool lib="8" name="Wiring Tool"/>
    <tool lib="8" name="Text Tool"/>
    <sep/>
    <tool lib="0" name="Pin"/>
    <tool lib="0" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/></tool>
    <sep/>
    <tool lib="1" name="NOT Gate"/><tool lib="1" name="AND Gate"/><tool lib="1" name="OR Gate"/>
    <tool lib="1" name="XOR Gate"/><tool lib="1" name="NAND Gate"/><tool lib="1" name="NOR Gate"/>
    <sep/>
    <tool lib="4" name="D Flip-Flop"/><tool lib="4" name="Register"/>
  </toolbar>

  <!-- ================================================================ -->
  <!-- 主电路: 顶层连线 (在 Logisim GUI 中按标签连接子电路引脚)      -->
  <!-- ================================================================ -->
  <circuit name="main">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="main"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="8.0"/>

    <!-- [DM1] 16×16 点阵, 锚点(700,200), type=select -->
    <comp lib="5" loc="(700,200)" name="DotMatrix">
      <a name="inputtype" val="select"/>
      <a name="matrixcols" val="16"/>
      <a name="matrixrows" val="16"/>
    </comp>

    <!-- [M8] 显示控制器, 锚点(200,200) -->
    <comp loc="(200,200)" name="model8"/>

    <!-- [M3] 小车控制, 锚点(200,600) -->
    <comp loc="(200,600)" name="model3"/>

    <!-- [M4] 障碍物控制, 锚点(500,600) -->
    <comp loc="(500,600)" name="model4"/>

    <!-- [BTN1] RST按钮, 锚点(100,600) -->
    <comp lib="5" loc="(100,600)" name="Button">
      <a name="label" val="RST"/>
    </comp>

    <!-- ===== 所有接线在 GUI 中完成，详见接线指南 ===== -->
    <!-- 连接表 (标签→标签):
         ① M8.ROW_ADDR → DM1.行选择(南侧)
         ② M8.COL_DATA → DM1.列数据(西侧)
         ③ M3.car_pos  → M8.CAR_COL
         ④ M4.OBS_COL  → M8.OBS_COL
         ⑤ M4.OBS_ROW  → M8.OBS_ROW
         ⑥ BTN1        → M8.RST
    -->

  </circuit>

  <!-- ================================================================ -->
  <!-- model3: 小车控制 (简化占位)                                       -->
  <!-- ================================================================ -->
  <circuit name="model3">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="model3"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <comp lib="0" loc="(100,100)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="car_pos"/>
      <a name="output" val="true"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="0" loc="(100,300)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="LEFT"/>
    </comp>
    <comp lib="0" loc="(100,360)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="RIGHT"/>
    </comp>
  </circuit>

  <!-- ================================================================ -->
  <!-- model4: 障碍物控制 (简化占位)                                    -->
  <!-- ================================================================ -->
  <circuit name="model4">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="model4"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <comp lib="0" loc="(180,100)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="OBS_COL"/>
      <a name="output" val="true"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="0" loc="(180,180)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="OBS_ROW"/>
      <a name="output" val="true"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="0" loc="(180,260)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="AT_BOTTOM"/>
      <a name="output" val="true"/>
    </comp>
  </circuit>

  <!-- ================================================================ -->
  <!-- model8: 逐行扫描显示控制器 (全新设计, 严格网格坐标)               -->
  <!-- ================================================================ -->
  <circuit name="model8">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="model8"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="8.0"/>

    <!-- ===== 区块A: 输入引脚 (X=100 列对齐) ===== -->
    <!-- [IN1] CAR_COL[3:0], (100,100), 4bit入 -->
    <comp lib="0" loc="(100,100)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="CAR_COL"/>
      <a name="width" val="4"/>
    </comp>
    <!-- [IN2] OBS_COL[3:0], (100,160), 4bit入 -->
    <comp lib="0" loc="(100,160)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="OBS_COL"/>
      <a name="width" val="4"/>
    </comp>
    <!-- [IN3] OBS_ROW[3:0], (100,220), 4bit入 -->
    <comp lib="0" loc="(100,220)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="OBS_ROW"/>
      <a name="width" val="4"/>
    </comp>
    <!-- [IN4] RST, (100,280), 1bit入 -->
    <comp lib="0" loc="(100,280)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="RST"/>
    </comp>

    <!-- ===== 区块B: 时钟源 ===== -->
    <!-- [CLK1] Clock, (100,40) -->
    <comp lib="0" loc="(100,40)" name="Clock"/>

    <!-- ===== 区块C: 行扫描计数器 (Y=100, X=200~450) ===== -->
    <!-- [REG1] SCAN_ROW 寄存器, (260,100), 4bit -->
    <comp lib="4" loc="(260,100)" name="Register">
      <a name="appearance" val="logisim_evolution"/>
      <a name="label" val="SCAN_ROW"/>
      <a name="width" val="4"/>
    </comp>
    <!-- [CON1] Constant=0x1, (200,160), 4bit -->
    <comp lib="0" loc="(200,160)" name="Constant">
      <a name="width" val="4"/>
    </comp>
    <!-- [ADD1] Adder +1, (370,100), 4bit -->
    <comp lib="3" loc="(370,100)" name="Adder">
      <a name="width" val="4"/>
    </comp>

    <!-- ===== 区块D: 列译码器 (Y=360/560, X=260, 间距200避免输出重叠) ===== -->
    <!-- [DEC1] Decoder CAR_COL, (260,360), 4→16, 输出跨度Y=370~520 -->
    <comp lib="2" loc="(260,360)" name="Decoder">
      <a name="select" val="4"/>
    </comp>
    <!-- [DEC2] Decoder OBS_COL, (260,560), 4→16, 输出跨度Y=570~720 -->
    <comp lib="2" loc="(260,560)" name="Decoder">
      <a name="select" val="4"/>
    </comp>

    <!-- ===== 区块E: Splitter 合并译码器输出 (X=400, Y=360/560) ===== -->
    <!-- [SPL1] Splitter CAR, (400,360) 16线→16位总线 -->
    <comp lib="0" loc="(400,360)" name="Splitter">
      <a name="fanout" val="16"/>
      <a name="incoming" val="16"/>
    </comp>
    <!-- [SPL2] Splitter OBS, (400,560) 16线→16位总线 -->
    <comp lib="0" loc="(400,560)" name="Splitter">
      <a name="fanout" val="16"/>
      <a name="incoming" val="16"/>
    </comp>

    <!-- ===== 区块F: 行匹配比较器 (Y=280/400, X=530) ===== -->
    <!-- [CON2] Constant=0xF, (470,250), 4bit -->
    <comp lib="0" loc="(470,250)" name="Constant">
      <a name="value" val="0xf"/>
      <a name="width" val="4"/>
    </comp>
    <!-- [CMP1] Comparator CAR_ROW, (530,260), 4bit -->
    <comp lib="3" loc="(530,260)" name="Comparator">
      <a name="width" val="4"/>
    </comp>
    <!-- [CMP2] Comparator OBS_ROW, (530,380), 4bit -->
    <comp lib="3" loc="(530,380)" name="Comparator">
      <a name="width" val="4"/>
    </comp>

    <!-- ===== 区块G: 像素合成 (Y=250/370, X=640~840) ===== -->
    <!-- [CON3] Constant=0x0000, (630,230), 16bit -->
    <comp lib="0" loc="(630,230)" name="Constant">
      <a name="width" val="16"/>
    </comp>
    <!-- [CON4] Constant=0x0000, (630,350), 16bit -->
    <comp lib="0" loc="(630,350)" name="Constant">
      <a name="width" val="16"/>
    </comp>
    <!-- [MUX1] MUX CAR, (720,250), 16bit, sel=1 -->
    <comp lib="2" loc="(720,250)" name="Multiplexer">
      <a name="width" val="16"/>
    </comp>
    <!-- [MUX2] MUX OBS, (720,370), 16bit, sel=1 -->
    <comp lib="2" loc="(720,370)" name="Multiplexer">
      <a name="width" val="16"/>
    </comp>
    <!-- [OR1] OR Gate, (840,310), 16bit -->
    <comp lib="1" loc="(840,310)" name="OR Gate">
      <a name="width" val="16"/>
    </comp>

    <!-- ===== 区块H: 输出引脚 (X=920 列对齐) ===== -->
    <!-- [OUT1] ROW_ADDR[3:0], (920,100), 4bit出 -->
    <comp lib="0" loc="(920,100)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="ROW_ADDR"/>
      <a name="output" val="true"/>
      <a name="width" val="4"/>
    </comp>
    <!-- [OUT2] COL_DATA[15:0], (920,310), 16bit出 -->
    <comp lib="0" loc="(920,310)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="COL_DATA"/>
      <a name="output" val="true"/>
      <a name="width" val="16"/>
    </comp>

    <!-- ================================================================ -->
    <!-- 导线清单 (全部正交: 水平+垂直, 拐点整数坐标, 严格点对点)        -->
    <!-- ================================================================ -->

    <!-- W1: [CLK1](100,40) → [REG1] CLK -->
    <wire from="(100,40)" to="(200,40)"/>
    <wire from="(200,40)" to="(200,130)"/>
    <wire from="(200,130)" to="(260,130)"/>

    <!-- W2: [CON1](200,160) → [ADD1] B输入 -->
    <wire from="(200,160)" to="(200,120)"/>
    <wire from="(200,120)" to="(370,120)"/>

    <!-- W3: [REG1] Q输出(290,100) → [ADD1] A输入(370,100) -->
    <wire from="(290,100)" to="(370,100)"/>

    <!-- W4: [ADD1] 输出(400,100) → [REG1] D输入(260,110) -->
    <wire from="(400,100)" to="(420,100)"/>
    <wire from="(420,100)" to="(420,180)"/>
    <wire from="(420,180)" to="(260,180)"/>

    <!-- W5: [IN4] RST(100,280) → [REG1] RST -->
    <wire from="(100,280)" to="(180,280)"/>
    <wire from="(180,280)" to="(180,150)"/>
    <wire from="(180,150)" to="(260,150)"/>

    <!-- W6: [REG1] Q(290,100) → [OUT1] ROW_ADDR(920,100) -->
    <wire from="(290,100)" to="(920,100)"/>

    <!-- W7: [REG1] Q → [CMP1] A输入 -->
    <wire from="(290,100)" to="(290,30)"/>
    <wire from="(290,30)" to="(500,30)"/>
    <wire from="(500,30)" to="(500,250)"/>
    <wire from="(500,250)" to="(530,250)"/>

    <!-- W8: [REG1] Q → [CMP2] A输入 -->
    <wire from="(500,30)" to="(500,370)"/>
    <wire from="(500,370)" to="(530,370)"/>

    <!-- W9: [CON2](470,250) → [CMP1] B输入 -->
    <wire from="(470,250)" to="(500,250)"/>

    <!-- W10: [IN3] OBS_ROW(100,220) → [CMP2] B输入 -->
    <wire from="(100,220)" to="(160,220)"/>
    <wire from="(160,220)" to="(160,400)"/>
    <wire from="(160,400)" to="(500,400)"/>
    <wire from="(500,400)" to="(530,400)"/>

    <!-- W11: [IN1] CAR_COL(100,100) → [DEC1] 输入(260,350) -->
    <wire from="(100,100)" to="(160,100)"/>
    <wire from="(160,100)" to="(160,350)"/>
    <wire from="(160,350)" to="(260,350)"/>

    <!-- W12: [IN2] OBS_COL(100,160) → [DEC2] 输入(260,550) -->
    <wire from="(100,160)" to="(140,160)"/>
    <wire from="(140,160)" to="(140,550)"/>
    <wire from="(140,550)" to="(260,550)"/>

    <!-- W13~W28: [DEC1] 16输出(Y=370~520) → [SPL1] 16输入 -->
    <wire from="(280,370)" to="(400,370)"/>
    <wire from="(280,380)" to="(400,380)"/>
    <wire from="(280,390)" to="(400,390)"/>
    <wire from="(280,400)" to="(400,400)"/>
    <wire from="(280,410)" to="(400,410)"/>
    <wire from="(280,420)" to="(400,420)"/>
    <wire from="(280,430)" to="(400,430)"/>
    <wire from="(280,440)" to="(400,440)"/>
    <wire from="(280,450)" to="(400,450)"/>
    <wire from="(280,460)" to="(400,460)"/>
    <wire from="(280,470)" to="(400,470)"/>
    <wire from="(280,480)" to="(400,480)"/>
    <wire from="(280,490)" to="(400,490)"/>
    <wire from="(280,500)" to="(400,500)"/>
    <wire from="(280,510)" to="(400,510)"/>
    <wire from="(280,520)" to="(400,520)"/>

    <!-- W29~W44: [DEC2] 16输出(Y=570~720) → [SPL2] 16输入 -->
    <wire from="(280,570)" to="(400,570)"/>
    <wire from="(280,580)" to="(400,580)"/>
    <wire from="(280,590)" to="(400,590)"/>
    <wire from="(280,600)" to="(400,600)"/>
    <wire from="(280,610)" to="(400,610)"/>
    <wire from="(280,620)" to="(400,620)"/>
    <wire from="(280,630)" to="(400,630)"/>
    <wire from="(280,640)" to="(400,640)"/>
    <wire from="(280,650)" to="(400,650)"/>
    <wire from="(280,660)" to="(400,660)"/>
    <wire from="(280,670)" to="(400,670)"/>
    <wire from="(280,680)" to="(400,680)"/>
    <wire from="(280,690)" to="(400,690)"/>
    <wire from="(280,700)" to="(400,700)"/>
    <wire from="(280,710)" to="(400,710)"/>
    <wire from="(280,720)" to="(400,720)"/>

    <!-- W45: [SPL1] 总线输出(430,360) → [MUX1] data1(720,270) -->
    <wire from="(430,360)" to="(460,360)"/>
    <wire from="(460,360)" to="(460,270)"/>
    <wire from="(460,270)" to="(720,270)"/>

    <!-- W46: [SPL2] 总线输出(430,560) → [MUX2] data1(720,390) -->
    <wire from="(430,560)" to="(480,560)"/>
    <wire from="(480,560)" to="(480,390)"/>
    <wire from="(480,390)" to="(720,390)"/>

    <!-- W47: [CON3](630,230) → [MUX1] data0(720,230) -->
    <wire from="(630,230)" to="(680,230)"/>
    <wire from="(680,230)" to="(720,230)"/>

    <!-- W48: [CON4](630,350) → [MUX2] data0(720,350) -->
    <wire from="(630,350)" to="(680,350)"/>
    <wire from="(680,350)" to="(720,350)"/>

    <!-- W49: [CMP1] EQ输出(560,260) → [MUX1] sel(720,210) -->
    <wire from="(560,260)" to="(600,260)"/>
    <wire from="(600,260)" to="(600,210)"/>
    <wire from="(600,210)" to="(720,210)"/>

    <!-- W50: [CMP2] EQ输出(560,380) → [MUX2] sel(720,330) -->
    <wire from="(560,380)" to="(620,380)"/>
    <wire from="(620,380)" to="(620,330)"/>
    <wire from="(620,330)" to="(720,330)"/>

    <!-- W51: [MUX1] 输出(750,250) → [OR1] A输入(840,300) -->
    <wire from="(750,250)" to="(790,250)"/>
    <wire from="(790,250)" to="(790,300)"/>
    <wire from="(790,300)" to="(840,300)"/>

    <!-- W52: [MUX2] 输出(750,370) → [OR1] B输入(840,320) -->
    <wire from="(750,370)" to="(810,370)"/>
    <wire from="(810,370)" to="(810,320)"/>
    <wire from="(810,320)" to="(840,320)"/>

    <!-- W53: [OR1] 输出(870,310) → [OUT2] COL_DATA(920,310) -->
    <wire from="(870,310)" to="(920,310)"/>

  </circuit>
</project>
