    <comp lib="5" loc="(210,510)" name="7-Segment Display"/>
    <comp lib="5" loc="(210,610)" name="7-Segment Display"/>
  </circuit>
  <circuit name="randon_design">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="randon_design"/>
