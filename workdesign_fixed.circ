    <!-- 行扫描计数器部分 -->
    <comp lib="0" loc="(110,130)" name="Constant">
      <a name="width" val="4"/>
    </comp>
    <comp lib="4" loc="(220,100)" name="Register">
      <a name="appearance" val="logisim_evolution"/>
      <a name="label" val="SCAN_ROW"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="3" loc="(310,100)" name="Adder">
      <a name="width" val="4"/>
    </comp>
    <!-- 列译码器 -->
    <comp lib="2" loc="(200,240)" name="Decoder">
      <a name="select" val="4"/>
    </comp>
    <comp lib="2" loc="(200,340)" name="Decoder">
      <a name="select" val="4"/>
    </comp>
    <!-- 行匹配比较器 -->
    <comp lib="0" loc="(370,240)" name="Constant">
      <a name="value" val="0xf"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="3" loc="(440,230)" name="Comparator">
      <a name="width" val="4"/>
    </comp>
    <comp lib="3" loc="(440,330)" name="Comparator">
      <a name="width" val="4"/>
    </comp>
    <!-- Splitter 用于将译码器输出合并为16位总线 -->
    <comp lib="0" loc="(320,240)" name="Splitter">
      <a name="fanout" val="16"/>
      <a name="incoming" val="16"/>
    </comp>
    <comp lib="0" loc="(320,340)" name="Splitter">
      <a name="fanout" val="16"/>
      <a name="incoming" val="16"/>
    </comp>
    <!-- 像素合成: 16位 MUX + 16位 OR -->
    <comp lib="0" loc="(550,210)" name="Constant">
      <a name="width" val="16"/>
    </comp>
    <comp lib="0" loc="(550,300)" name="Constant">
      <a name="width" val="16"/>
    </comp>
    <comp lib="2" loc="(630,210)" name="Multiplexer">
      <a name="width" val="16"/>
    </comp>
    <comp lib="2" loc="(630,300)" name="Multiplexer">
      <a name="width" val="16"/>
    </comp>
    <comp lib="1" loc="(740,250)" name="OR Gate">
      <a name="width" val="16"/>
    </comp>
    <!-- 输出引脚（右侧） -->
    <comp lib="0" loc="(820,80)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="ROW_ADDR"/>
      <a name="output" val="true"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="0" loc="(820,250)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="COL_DATA"/>
      <a name="output" val="true"/>
      <a name="width" val="16"/>
    </comp>
    <!-- 1×16 调试LED条 -->
    <comp lib="5" loc="(450,440)" name="DotMatrix">
      <a name="inputtype" val="row"/>
      <a name="label" val="ScanBar"/>
      <a name="matrixcols" val="1"/>
      <a name="matrixrows" val="16"/>
    </comp>
    <!-- ===== 导线：时钟和行计数器 ===== -->
    <wire from="(70,60)" to="(140,60)"/>
    <wire from="(140,60)" to="(140,140)"/>
    <wire from="(140,140)" to="(220,140)"/>
    <wire from="(110,130)" to="(170,130)"/>
    <wire from="(170,130)" to="(170,110)"/>
    <wire from="(170,110)" to="(220,110)"/>
    <wire from="(220,100)" to="(280,100)"/>
    <wire from="(280,100)" to="(310,100)"/>
    <wire from="(310,100)" to="(340,100)"/>
    <wire from="(340,100)" to="(340,170)"/>
    <wire from="(340,170)" to="(220,170)"/>
    <wire from="(280,100)" to="(280,70)"/>
    <wire from="(280,70)" to="(820,70)"/>
    <wire from="(820,70)" to="(820,80)"/>
    <!-- 比较器：SCAN_ROW vs CAR_ROW(15) -->
    <wire from="(280,70)" to="(400,70)"/>
    <wire from="(400,70)" to="(400,220)"/>
    <wire from="(400,220)" to="(440,220)"/>
    <wire from="(370,240)" to="(400,240)"/>
    <wire from="(400,240)" to="(440,240)"/>
    <!-- 比较器：SCAN_ROW vs OBS_ROW -->
    <wire from="(400,70)" to="(400,320)"/>
    <wire from="(400,320)" to="(440,320)"/>
    <wire from="(30,400)" to="(120,400)"/>
    <wire from="(120,400)" to="(120,350)"/>
    <wire from="(120,350)" to="(440,350)"/>
    <!-- RST → Register -->
    <wire from="(30,480)" to="(150,480)"/>
    <wire from="(150,480)" to="(150,160)"/>
    <wire from="(150,160)" to="(220,160)"/>
    <!-- ===== 导线：列译码器输入 ===== -->
    <wire from="(30,240)" to="(120,240)"/>
    <wire from="(120,240)" to="(200,240)"/>
    <wire from="(30,320)" to="(120,320)"/>
    <wire from="(120,320)" to="(120,330)"/>
    <wire from="(120,330)" to="(200,330)"/>
    <!-- ===== 导线：译码器 → Splitter (16条线) ===== -->
    <wire from="(200,260)" to="(210,260)"/>
    <wire from="(210,260)" to="(320,260)"/>
    <wire from="(200,270)" to="(210,270)"/>
    <wire from="(210,270)" to="(320,270)"/>
    <wire from="(200,280)" to="(210,280)"/>
    <wire from="(210,280)" to="(320,280)"/>
    <wire from="(200,290)" to="(210,290)"/>
    <wire from="(210,290)" to="(320,290)"/>
    <wire from="(200,360)" to="(210,360)"/>
    <wire from="(210,360)" to="(320,360)"/>
    <wire from="(200,370)" to="(210,370)"/>
    <wire from="(210,370)" to="(320,370)"/>
    <wire from="(200,380)" to="(210,380)"/>
    <wire from="(210,380)" to="(320,380)"/>
    <wire from="(200,390)" to="(210,390)"/>
    <wire from="(210,390)" to="(320,390)"/>
    <!-- ===== 导线：Splitter → MUX data1 ===== -->
    <wire from="(320,240)" to="(390,240)"/>
    <wire from="(390,240)" to="(390,220)"/>
    <wire from="(390,220)" to="(630,220)"/>
    <wire from="(320,340)" to="(390,340)"/>
    <wire from="(390,340)" to="(390,320)"/>
    <wire from="(390,320)" to="(630,320)"/>
    <!-- Constant 0x0000 → MUX data0 -->
    <wire from="(550,210)" to="(590,210)"/>
    <wire from="(590,210)" to="(630,210)"/>
    <wire from="(550,300)" to="(590,300)"/>
    <wire from="(590,300)" to="(630,300)"/>
    <!-- 比较器输出 → MUX select -->
    <wire from="(440,230)" to="(510,230)"/>
    <wire from="(510,230)" to="(510,190)"/>
    <wire from="(510,190)" to="(630,190)"/>
    <wire from="(440,330)" to="(510,330)"/>
    <wire from="(510,330)" to="(510,290)"/>
    <wire from="(510,290)" to="(630,290)"/>
    <!-- MUX 输出 → OR 输入 -->
    <wire from="(630,210)" to="(690,210)"/>
    <wire from="(690,210)" to="(690,240)"/>
    <wire from="(690,240)" to="(740,240)"/>
    <wire from="(630,300)" to="(690,300)"/>
    <wire from="(690,300)" to="(690,260)"/>
    <wire from="(690,260)" to="(740,260)"/>
    <!-- OR 输出 → COL_DATA 引脚 -->
    <wire from="(740,250)" to="(790,250)"/>
    <wire from="(790,250)" to="(820,250)"/>
    <!-- ===== 调试LED: SCAN_ROW → 1×16点阵 ===== -->
    <wire from="(280,70)" to="(450,70)"/>
    <wire from="(450,70)" to="(450,440)"/>
  </circuit>
  <circuit name="Output_system">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="Output_system"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="2.0"/>
    <comp lib="10" loc="(200,460)" name="Buzzer"/>
    <comp lib="5" loc="(210,340)" name="LED">
