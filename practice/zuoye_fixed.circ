<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="3.8.0" version="1.0">
  This file is intended to be loaded by Logisim-Evolution v3.8.0 (https://github.com/logisim-evolution/).
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#TTL" name="6"/>
  <lib desc="#TCL" name="7"/>
  <lib desc="#Base" name="8"/>
  <lib desc="#BFH-Praktika" name="9"/>
  <lib desc="#Input/Output-Extra" name="10"/>
  <lib desc="#Soc" name="11"/>
  <main name="TBIT"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <mappings>
    <tool lib="8" map="Button2" name="Poke Tool"/>
    <tool lib="8" map="Button3" name="Menu Tool"/>
    <tool lib="8" map="Ctrl Button1" name="Menu Tool"/>
  </mappings>
  <toolbar>
    <tool lib="8" name="Poke Tool"/>
    <tool lib="8" name="Edit Tool"/>
    <tool lib="8" name="Wiring Tool"/>
    <tool lib="8" name="Text Tool"/>
    <sep/>
    <tool lib="0" name="Pin"/>
    <tool lib="0" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
    </tool>
    <sep/>
    <tool lib="1" name="NOT Gate"/>
    <tool lib="1" name="AND Gate"/>
    <tool lib="1" name="OR Gate"/>
    <tool lib="1" name="XOR Gate"/>
    <tool lib="1" name="NAND Gate"/>
    <tool lib="1" name="NOR Gate"/>
    <sep/>
    <tool lib="4" name="D Flip-Flop"/>
    <tool lib="4" name="Register"/>
  </toolbar>

  <!-- ============================================================
       FULLADDER Sub-circuit
       Ports (left, top to bottom): Cin(y=60), B(y=90), A(y=120)
       Ports (right, top to bottom): Cout(y=60), S(y=90)
       Instance at (x,y): 
         Cin  = (x-175, y-30)
         B    = (x-175, y)
         A    = (x-175, y+30)
         Cout = (x+175, y-30)
         S    = (x+175, y)
       ============================================================ -->
  <circuit name="FULLADDER">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="FULLADDER"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="1.0"/>
    <!-- Input pins (left side, x=120) -->
    <comp lib="0" loc="(120,60)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="Cin"/>
    </comp>
    <comp lib="0" loc="(120,90)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="B"/>
    </comp>
    <comp lib="0" loc="(120,120)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="A"/>
    </comp>
    <!-- Output pins (right side, x=470) -->
    <comp lib="0" loc="(470,60)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="Cout"/>
      <a name="output" val="true"/>
    </comp>
    <comp lib="0" loc="(470,90)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="S"/>
      <a name="output" val="true"/>
    </comp>
    <!-- S = A xor B xor Cin -->
    <comp lib="1" loc="(220,75)" name="XOR Gate">
      <a name="size" val="30"/>
    </comp>
    <comp lib="1" loc="(340,90)" name="XOR Gate">
      <a name="size" val="30"/>
    </comp>
    <!-- Cout = AB + ACin + BCin -->
    <comp lib="1" loc="(220,160)" name="AND Gate">
      <a name="size" val="30"/>
    </comp>
    <comp lib="1" loc="(280,130)" name="AND Gate">
      <a name="size" val="30"/>
    </comp>
    <comp lib="1" loc="(410,130)" name="OR Gate">
      <a name="size" val="30"/>
      <a name="inputs" val="2"/>
    </comp>
    <!-- Wires for S = A xor B xor Cin -->
    <wire from="(120,120)" to="(190,120)"/>
    <wire from="(190,120)" to="(190,85)"/>
    <wire from="(120,90)" to="(190,90)"/>
    <wire from="(190,90)" to="(190,85)"/>
    <wire from="(190,85)" to="(190,75)"/>
    <wire from="(120,60)" to="(310,60)"/>
    <wire from="(310,60)" to="(310,90)"/>
    <wire from="(250,75)" to="(310,75)"/>
    <wire from="(310,75)" to="(310,90)"/>
    <wire from="(370,90)" to="(440,90)"/>
    <wire from="(440,90)" to="(440,90)"/>
    <wire from="(440,90)" to="(470,90)"/>
    <!-- Wires for Cout = AB + ACin + BCin -->
    <wire from="(190,120)" to="(190,150)"/>
    <wire from="(190,90)" to="(190,170)"/>
    <wire from="(190,150)" to="(220,160)"/>
    <wire from="(190,170)" to="(220,170)"/>
    <wire from="(250,75)" to="(250,120)"/>
    <wire from="(250,120)" to="(260,120)"/>
    <wire from="(260,120)" to="(260,130)"/>
    <wire from="(310,60)" to="(310,110)"/>
    <wire from="(310,110)" to="(280,130)"/>
    <wire from="(250,160)" to="(390,160)"/>
    <wire from="(390,160)" to="(390,150)"/>
    <wire from="(390,150)" to="(410,130)"/>
    <wire from="(250,130)" to="(390,130)"/>
    <wire from="(390,130)" to="(390,140)"/>
    <wire from="(390,140)" to="(410,140)"/>
    <wire from="(440,130)" to="(470,130)"/>
    <wire from="(470,130)" to="(470,60)"/>
  </circuit>

  <!-- ============================================================
       TBIT: 2-bit Ripple-Carry Adder
       FA0 at (280, 120): 
         Cin=(105,90), B=(105,120), A=(105,150)
         Cout=(455,90), S=(455,120)
       FA1 at (280, 250):
         Cin=(105,220), B=(105,250), A=(105,280)
         Cout=(455,220), S=(455,250)
       ============================================================ -->
  <circuit name="TBIT">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="TBIT"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="1.0"/>

    <!-- ===== Input Pins (left, x=60) ===== -->
    <!-- CIN0 -> FA0.Cin(105,90) -->
    <comp lib="0" loc="(60,90)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="CIN0"/>
    </comp>
    <!-- A0 -> FA0.A(105,150) -->
    <comp lib="0" loc="(60,150)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="A0"/>
    </comp>
    <!-- B0 -> FA0.B(105,120) -->
    <comp lib="0" loc="(60,120)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="B0"/>
    </comp>
    <!-- A1 -> FA1.A(105,280) -->
    <comp lib="0" loc="(60,280)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="A1"/>
    </comp>
    <!-- B1 -> FA1.B(105,250) -->
    <comp lib="0" loc="(60,250)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="B1"/>
    </comp>

    <!-- ===== Output Pins (right, x=530) ===== -->
    <comp lib="0" loc="(530,120)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="S0"/>
      <a name="output" val="true"/>
    </comp>
    <comp lib="0" loc="(530,250)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="S1"/>
      <a name="output" val="true"/>
    </comp>
    <comp lib="0" loc="(530,400)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="overflow"/>
      <a name="output" val="true"/>
    </comp>

    <!-- ===== FULLADDER Instances ===== -->
    <!-- FA0: bit 0, loc=(280,120) -->
    <comp loc="(280,120)" name="FULLADDER"/>
    <!-- FA1: bit 1, loc=(280,250) -->
    <comp loc="(280,250)" name="FULLADDER"/>

    <!-- ===== Wires: Inputs to FA0 ===== -->
    <!-- CIN0(60,90) -> FA0.Cin(105,90) -->
    <wire from="(60,90)" to="(105,90)"/>
    <!-- A0(60,150) -> FA0.A(105,150) -->
    <wire from="(60,150)" to="(105,150)"/>
    <!-- B0(60,120) -> FA0.B(105,120) -->
    <wire from="(60,120)" to="(105,120)"/>

    <!-- ===== Wires: Outputs from FA0 ===== -->
    <!-- FA0.S(455,120) -> S0(530,120) -->
    <wire from="(455,120)" to="(530,120)"/>
    <!-- FA0.Cout(455,90) -> carry to FA1.Cin -->

    <!-- ===== Wires: Carry chain FA0.Cout -> FA1.Cin ===== -->
    <!-- FA0.Cout(455,90) -> route right then down to FA1.Cin(105,220) -->
    <wire from="(455,90)" to="(480,90)"/>
    <wire from="(480,90)" to="(480,220)"/>
    <wire from="(480,220)" to="(105,220)"/>

    <!-- ===== Wires: Inputs to FA1 ===== -->
    <!-- A1(60,280) -> FA1.A(105,280) -->
    <wire from="(60,280)" to="(105,280)"/>
    <!-- B1(60,250) -> FA1.B(105,250) -->
    <wire from="(60,250)" to="(105,250)"/>

    <!-- ===== Wires: Outputs from FA1 ===== -->
    <!-- FA1.S(455,250) -> S1(530,250) -->
    <wire from="(455,250)" to="(530,250)"/>

    <!-- ===== Overflow: overflow = Cout0 xor Cout1 ===== -->
    <!-- XOR gate at (420,400) -->
    <comp lib="1" loc="(420,400)" name="XOR Gate">
      <a name="size" val="30"/>
      <a name="inputs" val="2"/>
    </comp>
    <!-- Cout0(455,90) -> route to XOR top input -->
    <wire from="(455,90)" to="(455,350)"/>
    <wire from="(455,350)" to="(390,350)"/>
    <wire from="(390,350)" to="(390,390)"/>
    <wire from="(390,390)" to="(420,390)"/>
    <!-- Cout1(455,220) -> route to XOR bottom input -->
    <wire from="(455,220)" to="(455,380)"/>
    <wire from="(455,380)" to="(390,380)"/>
    <wire from="(390,380)" to="(390,410)"/>
    <wire from="(390,410)" to="(420,410)"/>
    <!-- XOR output -> overflow pin -->
    <wire from="(450,400)" to="(530,400)"/>

  </circuit>
</project>
